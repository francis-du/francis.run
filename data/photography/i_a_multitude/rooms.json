    "number": "03",
    "quote": {
      "text": {
        "zh": "我到底\n是活着，还是正在死去\n是死去，还是等待着重生",
        "en": "Am I, after all,\nalive, or in the midst of dying?\nDead, or awaiting rebirth?"
      },
      "source": {
        "zh": "弗朗摩斯 · 《半活》",
        "en": "Francis Du · Half Alive"
      },
      "url": ""
