          99
        ],
        "guide": {
          "text": {
            "zh": "我听见我呼唤我，却无法替这个声音命名。\n渴望将我抱紧，也将我撕开。",
            "en": "I hear myself calling myself, yet cannot give this voice a name.\nLonging holds me close, and tears me open."
          },
          "source": {
            "zh": "策展札记",
            "en": "Curatorial note"
          },
          "url": ""
